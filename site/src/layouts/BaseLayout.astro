---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Parenting Evidence",
  description = "育児について、現在の研究から何が分かっていて、何がまだ分からないかを整理するEvidence Review。"
} = Astro.props;

const pageTitle =
  title === "Parenting Evidence"
    ? title
    : `${title} | Parenting Evidence`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f1e8" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">Parenting Evidence</a>
        <nav aria-label="主要ナビゲーション">
          <a href="/">レビュー</a>
          <a href="/methodology">調査方法</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>育児の「正解」ではなく、現在の証拠と不確実性を整理します。</p>
        <p>個別の診断・治療・受診判断を提供するものではありません。</p>
      </div>
    </footer>
  </body>
</html>
