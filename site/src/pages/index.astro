---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getReviewSummaries } from "../lib/reviews";

const reviews = getReviewSummaries();
const domains = [...new Set(reviews.map((review) => review.domain))];
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">Evidence reviews for everyday parenting questions</p>
    <h1>育児の疑問を、<br />研究の届くところまで。</h1>
    <p class="lead">
      結論だけではなく、何が分かっていて、何がまだ分からないのか。
      研究の種類、限界、日本の家庭への当てはまりまで確認できる形で整理します。
    </p>
    <p class="notice">
      公開中のEvidence Reviewは独立確認を経ており、各ページで結論だけでなく、主要研究と検索方法まで確認できます。
    </p>
  </section>

  <section class="shell explorer" aria-labelledby="reviews-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Reviews</p>
        <h2 id="reviews-title">何について知りたいですか？</h2>
      </div>
      <p id="result-count" class="result-count" aria-live="polite">{reviews.length}件</p>
    </div>

    <div class="filters" aria-label="レビューを絞り込む">
      <label>
        <span>キーワード</span>
        <input id="review-search" type="search" placeholder="睡眠、言葉、しつけ…" />
      </label>

      <label>
        <span>年齢</span>
        <select id="age-filter">
          <option value="">すべて</option>
          <option value="0-1">0〜1歳</option>
          <option value="1-3">1〜3歳</option>
          <option value="3-6">3〜6歳</option>
        </select>
      </label>

      <label>
        <span>分野</span>
        <select id="domain-filter">
          <option value="">すべて</option>
          {domains.map((domain) => <option value={domain}>{domain}</option>)}
        </select>
      </label>
    </div>

    <ol class="review-list">
      {reviews.map((review, index) => (
        <li
          class="review-item"
          data-review
          data-search={review.searchText}
          data-domain={review.domain}
          data-age={review.ageBands.join(",")}
        >
          <a class="review-link" href={`/reviews/${review.slug}`}>
            <div class="review-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div class="review-main">
              <div class="review-meta">
                <span>{review.domain}</span>
                <span>{review.ageLabel}</span>
              </div>
              <h3>{review.title}</h3>
              <p>{review.summary}</p>
              <p class="review-date">最終検索 {review.lastSearched || "未設定"}</p>
            </div>
            <div class="review-arrow" aria-hidden="true">→</div>
          </a>
        </li>
      ))}
    </ol>

    <p id="no-results" class="no-results" hidden>
      条件に合うレビューはまだありません。今後の調査候補として、この「見つからなかった問い」自体も重要な情報として扱います。
    </p>
  </section>

  <section class="method-strip">
    <div class="shell method-strip-inner">
      <div>
        <p class="eyebrow">Method</p>
        <h2>結論の裏側まで辿れるようにします。</h2>
      </div>
      <p>
        Evidence Reviewは、Question → Claim → Outcome → Evidenceの単位で整理します。
        相関と因果、介入全体と個別技法、「差がない」と「証拠不足」を分けます。
      </p>
      <a class="text-link" href="/methodology">調査方法を見る →</a>
    </div>
  </section>

  <script>
    const search = document.querySelector("#review-search");
    const age = document.querySelector("#age-filter");
    const domain = document.querySelector("#domain-filter");
    const count = document.querySelector("#result-count");
    const noResults = document.querySelector("#no-results");
    const items = Array.from(document.querySelectorAll("[data-review]"));

    function applyFilters() {
      const query = search instanceof HTMLInputElement
        ? search.value.trim().toLowerCase()
        : "";
      const ageValue = age instanceof HTMLSelectElement ? age.value : "";
      const domainValue =
        domain instanceof HTMLSelectElement ? domain.value : "";

      let visible = 0;

      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;

        const matchesQuery =
          !query || (item.dataset.search ?? "").includes(query);
        const matchesAge =
          !ageValue ||
          (item.dataset.age ?? "").split(",").includes(ageValue);
        const matchesDomain =
          !domainValue || item.dataset.domain === domainValue;

        item.hidden = !(matchesQuery && matchesAge && matchesDomain);
        if (!item.hidden) visible += 1;
      });

      if (count) count.textContent = `${visible}件`;
      if (noResults instanceof HTMLElement) noResults.hidden = visible !== 0;
    }

    search?.addEventListener("input", applyFilters);
    age?.addEventListener("change", applyFilters);
    domain?.addEventListener("change", applyFilters);
  </script>
</BaseLayout>
